<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      O starter-parent traz o gerenciamento de versões de todo o ecossistema Spring.
      Herdar dele significa declarar dependências sem <version> e ter a garantia de
      que as versões combinam entre si.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.catalogo</groupId>
    <artifactId>catalogo-produtos-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>catalogo-produtos-api</name>
    <description>API REST de catálogo e controle de estoque de produtos</description>

    <properties>
        <java.version>21</java.version>
        <!-- springdoc 3.1.1 é a linha construída sobre o Spring Boot 4.1.x. -->
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <dependencies>
        <!-- MVC, Jackson e servidor embarcado. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation: valida os DTOs de entrada antes de a regra de negócio rodar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA/Hibernate + repositórios Spring Data. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          Migrações de schema versionadas: o schema é responsabilidade do Flyway,
          nunca do Hibernate (ver 'ddl-auto: validate' no application.yml).
          No Spring Boot 4 a auto-configuração do Flyway saiu do jar 'autoconfigure'
          e passou a viver em um starter próprio: declarar apenas 'flyway-core'
          compila, mas as migrações nunca rodam.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Suporte do Flyway ao dialeto do PostgreSQL (módulo separado desde o Flyway 10). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Driver do banco de produção/desenvolvimento. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Gera a documentação OpenAPI e o Swagger UI a partir dos próprios
          controllers e payloads: a documentação acompanha o código por construção,
          em vez de divergir dele na primeira semana.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Health check em /actuator/health, para o orquestrador saber se a
          aplicação está viva. Só esse endpoint é exposto (ver application.yml).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          JUnit 5, Mockito e AssertJ para os testes unitários. Escopo 'test': entra
          na compilação e na execução dos testes, mas não vai para o jar final.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              Empacota a aplicação em um jar executável e é quem responde por
              'mvn spring-boot:run'.

              O perfil 'dev' vale só para o 'spring-boot:run': é ele que traz a
              conexão com o banco do docker-compose. O jar não carrega perfil
              nenhum e exige as variáveis DB_*.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
