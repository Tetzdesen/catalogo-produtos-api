# Copie para .env e ajuste conforme o ambiente.
# Os valores abaixo correspondem ao serviço do docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/catalogo
DB_USER=catalogo
DB_PASSWORD=catalogo
# Emissor e audiência dos JWT: o Keycloak e o realm do docker-compose.yml.
JWT_ISSUER_URI=http://localhost:8180/realms/catalogo
JWT_AUDIENCE=catalogo-api
